# =====================================================
# Veterion - variáveis de ambiente
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
# O ".env" real NUNCA deve ser commitado (já está no .gitignore).
# =====================================================

# Porta em que a API (backend) escuta
PORT=3000

# Porta em que o frontend estático é servido
FRONTEND_PORT=5500

# "Pepper" usado no hash determinístico de busca do CPF (HMAC-SHA256),
# usado só para detectar CPF duplicado - NÃO é a chave que protege o CPF
# em si (isso é feito com scrypt + salt aleatório, sempre).
# Gere um valor próprio e aleatório para produção, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilize o valor de exemplo abaixo em produção.
VETERION_PEPPER=troque-por-um-valor-aleatorio-proprio
