digraph DER {
  graph [rankdir=LR, splines=ortho, bgcolor="white", fontname="Segoe UI", nodesep=0.9, ranksep=1.3, label="Veterion - Diagrama de Entidade e Relacionamento", labelloc=t, fontsize=16, fontcolor="#241f33"];
  node [shape=plain, fontname="Segoe UI"];
  edge [fontname="Segoe UI", fontsize=11, color="#5b3e9d", penwidth=1.4];

  USUARIOS [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="white" color="#5b3e9d">
      <tr><td bgcolor="#5b3e9d" align="center"><font color="white"><b>USUARIOS</b></font></td></tr>
      <tr><td align="left"><font point-size="11">PK  id : INTEGER</font></td></tr>
      <tr><td align="left"><font point-size="11">     nome : VARCHAR(100) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">UK  login : VARCHAR(50) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     senha_hash : VARCHAR(200) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     papel : VARCHAR(20) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT 'recepcao'</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     CHECK IN (admin, veterinario, recepcao)</font></td></tr>
      <tr><td align="left"><font point-size="11">     criado_em : DATETIME NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT CURRENT_TIMESTAMP</font></td></tr>
    </table>
  >];

  TUTORES [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="white" color="#5b3e9d">
      <tr><td bgcolor="#5b3e9d" align="center"><font color="white"><b>TUTORES</b></font></td></tr>
      <tr><td align="left"><font point-size="11">PK  id : INTEGER</font></td></tr>
      <tr><td align="left"><font point-size="11">     nome : VARCHAR(100) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     cpf_hash : VARCHAR(200) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     (scrypt+salt, não reversível)</font></td></tr>
      <tr><td align="left"><font point-size="11">UK  cpf_busca : VARCHAR(64) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     (HMAC determinístico p/ duplicidade)</font></td></tr>
      <tr><td align="left"><font point-size="11">     telefone : VARCHAR(20)</font></td></tr>
      <tr><td align="left"><font point-size="11">     email : VARCHAR(100)</font></td></tr>
      <tr><td align="left"><font point-size="11">     criado_em : DATETIME NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT CURRENT_TIMESTAMP</font></td></tr>
    </table>
  >];

  PETS [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="white" color="#16a394">
      <tr><td bgcolor="#16a394" align="center"><font color="white"><b>PETS</b></font></td></tr>
      <tr><td align="left"><font point-size="11">PK  id : INTEGER</font></td></tr>
      <tr><td align="left"><font point-size="11">     nome : VARCHAR(50) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     especie : VARCHAR(30) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     raca : VARCHAR(50)</font></td></tr>
      <tr><td align="left"><font point-size="11">     data_nascimento : DATE</font></td></tr>
      <tr><td align="left"><font point-size="11">FK  tutor_id : INTEGER NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     → TUTORES.id, ON DELETE CASCADE</font></td></tr>
      <tr><td align="left"><font point-size="11">     criado_em : DATETIME NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT CURRENT_TIMESTAMP</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#16a394">     [idx] tutor_id</font></td></tr>
    </table>
  >];

  AGENDAMENTOS [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="5" bgcolor="white" color="#42296f">
      <tr><td bgcolor="#42296f" align="center"><font color="white"><b>AGENDAMENTOS</b></font></td></tr>
      <tr><td align="left"><font point-size="11">PK  id : INTEGER</font></td></tr>
      <tr><td align="left"><font point-size="11">FK  pet_id : INTEGER NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     → PETS.id, ON DELETE CASCADE</font></td></tr>
      <tr><td align="left"><font point-size="11">     data_agendamento : DATETIME NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     servico : VARCHAR(100) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="11">     status : VARCHAR(20) NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT 'Agendado'</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     CHECK IN (Agendado, Concluído, Cancelado)</font></td></tr>
      <tr><td align="left"><font point-size="11">     observacoes : VARCHAR(255)</font></td></tr>
      <tr><td align="left"><font point-size="11">     criado_em : DATETIME NOT NULL</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#6b6480">     DEFAULT CURRENT_TIMESTAMP</font></td></tr>
      <tr><td align="left"><font point-size="9" color="#42296f">     [idx] pet_id, data_agendamento</font></td></tr>
    </table>
  >];

  TUTORES -> PETS [xlabel="1        N", arrowhead=crow, arrowtail=tee, dir=both];
  PETS -> AGENDAMENTOS [xlabel="1        N", arrowhead=crow, arrowtail=tee, dir=both];

  { rank=same; USUARIOS }
}
